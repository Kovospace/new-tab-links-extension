{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "lib": [
      "DOM",
      "ES2020"
    ],
    "types": [
      "chrome",
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test"
  ]
}
