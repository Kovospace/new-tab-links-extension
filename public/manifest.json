{
  "manifest_version": 3,
  "name": "Workspace Links",
  "version": "0.1.0",
  "description": "Custom new tab workspace",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "contextMenus",
    "favicon"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "bookmark-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Bookmark the current page"
    }
  }
}